{
  "manifest_version": 3,
  "name": "Excali Up: Local Vault, Motion Effects & GIFs",
  "short_name": "Excali Up",
  "version": "5.5.0",
  "description": "Auto-save drawings to local folders, animate GIFs and SVGs, add colorful arrow motion effects, and browse Iconify in Excalidraw.",
  "homepage_url": "https://excaliup.astrofocus.app/",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["vendor/iconify-icon.min.js", "omggif.js", "excaliup-core.js", "excaliup-flow.js", "inject.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
